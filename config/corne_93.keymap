// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    //

    behaviors {
        esc_win_ht: esc_win_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "ESC_WIN_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <60000>;  // 60 seconds — effectively "no timeout"
            retro-tap;
            bindings = <&win_gui_layer>, <&kp>;
        };

        alt_tab_hjkl: alt_tab_hjkl {
            compatible = "zmk,behavior-toggle-layer";
            label = "ALT_TAB_HJKL";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        ctrl_hold_tap: ctrl_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "CTRL_HOLD_TAP";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            hold-while-undecided;
            tapping-term-ms = <150>;
        };
    };

    macros {
        win_gui_layer: win_gui_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "WIN_GUI_LAYER";
            bindings =
                <&macro_press>,
                <&kp LGUI &mo 5>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LGUI &mo 5>;

            wait-ms = <0>;
            tap-ms = <0>;
        };

        alt: alt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT &mo 6>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LALT &mo 6>,
                <&macro_tap>,
                <&to 0>;

            label = "ALT";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        alt_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TAB &alt_tab_hjkl 1>;
            label = "ALT_TAB";
        };
    };

    combos {
        compatible = "zmk,combos";

        df-ctrl {
            bindings = <&ctrl_hold_tap LCTRL LCTRL>;
            key-positions = <15 16>;
        };

        gaming {
            bindings = <&tog 7>;
            key-positions = <16 14 3>;
        };

        soft_off_left {
            bindings = <&soft_off>;
            key-positions = <36 37 38>;
        };

        soff_off_right {
            bindings = <&soft_off>;
            key-positions = <39 40 41>;
        };

        bootloader_left {
            bindings = <&mo 11>;
            key-positions = <5 29>;
        };

        bootloader_right {
            bindings = <&mo 11>;
            key-positions = <6 30>;
        };

        mouse {
            bindings = <&to 10>;
            key-positions = <19 20 21>;
            layers = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC  &esc_win_ht 0 ESC  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT  &kp LSHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp DEL  &alt  &kp SPACE  &mo 1  &mo 2  &kp RET  &kp LCTRL
            >;
        };

        lower_layer {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp HOME  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp PAGE_DOWN  &kp PAGE_UP  &trans  &kp END  &trans  &trans  &trans  &trans  &mo 3  &trans  &trans
            >;
        };

        raise_layer {
            bindings = <
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE  &trans  &trans  &trans  &trans  &trans  &trans  &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE  &trans  &trans  &mo 3  &trans  &trans  &trans
            >;
        };

        middle {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans  &caps_word  &kp F11  &kp F12  &trans  &trans  &trans  &kp C_PLAY_PAUSE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        default_duplicate {
            bindings = <
&kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC  &esc_win_ht 0 ESC  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT  &kp LSHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RGUI  &kp LALT  &kp SPACE  &mo 1  &mo 2  &kp RET  &kp RCTRL
            >;
        };

        win_solo {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none  &trans  &trans  &trans  &trans
            >;
        };

        alt {
            bindings = <
&alt_tab  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        gaming_general {
            bindings = <
&kp T  &kp TAB  &kp Q  &kp W  &kp E  &kp R  &trans  &trans  &trans  &trans  &trans  &to 0  &kp G  &kp ESC  &kp A  &kp S  &kp D  &kp F  &trans  &trans  &trans  &trans  &trans  &trans  &kp B  &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &trans  &trans  &trans  &trans  &trans  &trans  &kp LCTRL  &lt 9 SPACE  &mo 8  &trans  &trans  &trans
            >;
        };

        gaming_general_2 {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N4  &kp N5  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N0  &kp N9  &kp N8  &kp N7  &kp N6  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        right_mirror {
            bindings = <
&trans  &kp P  &kp O  &kp I  &kp U  &kp Y  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp L  &kp K  &kp J  &kp H  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp M  &kp N  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &to 0  &trans  &trans  &trans  &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &trans  &trans  &mkp RCLK  &trans
            >;
        };

        bootloader {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bootloader  &bootloader  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
