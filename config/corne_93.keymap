// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    //

    behaviors {
        alt_tab_hjkl: alt_tab_hjkl {
            compatible = "zmk,behavior-toggle-layer";
            label = "ALT_TAB_HJKL";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        lower_and_ctrl: lower_and_ctrl {
            compatible = "zmk,behavior-tap-dance";
            label = "LOWER_AND_CTRL";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&kp LCTRL>;

            tapping-term-ms = <250>;
        };

        gaming2_and_mirror: gaming2_and_mirror {
            compatible = "zmk,behavior-tap-dance";
            label = "GAMING2_AND_MIRROR";
            #binding-cells = <0>;
            bindings = <&mo 7>, <&mo 8>;

            tapping-term-ms = <250>;
        };

        my_hold_tap: my_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MY_HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            retro-tap;
            tapping-term-ms = <150>;
            flavor = "tap-unless-interrupted";
        };

        my_layer_tap: my_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MY_LAYER_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <60000>;
            retro-tap;
        };
    };

    macros {
        win_gui_layer: win_gui_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "WIN_GUI_LAYER";
            bindings =
                <&macro_press>,
                <&kp LGUI &mo 4>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LGUI &mo 4>;

            wait-ms = <0>;
            tap-ms = <0>;
        };

        alt: alt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT &mo 5>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LALT &mo 5>,
                <&macro_tap>,
                <&to 0>;

            label = "ALT";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        alt_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TAB &alt_tab_hjkl 1>;
            label = "ALT_TAB";
        };
    };

    combos {
        compatible = "zmk,combos";

        soff_off_right {
            bindings = <&soft_off>;
            key-positions = <39 40 41>;
        };

        bootloader_left {
            bindings = <&mo 10>;
            key-positions = <36 38>;
        };

        bootloader_right {
            bindings = <&mo 10>;
            key-positions = <39 41>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC  &my_hold_tap LEFT_WIN ESC  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT  &kp LSHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &my_hold_tap RIGHT_SHIFT DELETE  &alt  &kp SPACE  &lower_and_ctrl  &mo 2  &kp ENTER  &kp LCTRL
            >;
        };

        lower_layer {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans  &trans  &trans  &trans  &trans  &mo 9  &tog 6  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp HOME  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp PAGE_DOWN  &kp PAGE_UP  &trans  &kp END  &trans  &trans  &trans  &trans  &mo 3  &trans  &trans
            >;
        };

        raise_layer {
            bindings = <
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &trans  &kp LWIN  &trans  &trans  &trans  &trans  &trans  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE  &trans  &trans  &trans  &trans  &trans  &trans  &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE  &trans  &trans  &mo 3  &trans  &trans  &trans
            >;
        };

        middle {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans  &caps_word  &kp F11  &kp F12  &trans  &trans  &trans  &kp C_PLAY_PAUSE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        win_solo {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none  &trans  &trans  &trans  &trans
            >;
        };

        alt {
            bindings = <
&alt_tab  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        gaming_general {
            bindings = <
&kp T  &kp TAB  &kp Q  &kp W  &kp E  &kp R  &trans  &trans  &trans  &trans  &trans  &to 0  &kp G  &kp ESC  &kp A  &kp S  &kp D  &kp F  &trans  &trans  &trans  &trans  &trans  &trans  &kp B  &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &trans  &trans  &trans  &trans  &trans  &trans  &kp LCTRL  &kp SPACE  &gaming2_and_mirror  &trans  &trans  &trans
            >;
        };

        gaming_general_2 {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N4  &kp N5  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N0  &kp N9  &kp N8  &kp N7  &kp N6  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        right_mirror {
            bindings = <
&none  &kp P  &kp O  &kp I  &kp U  &kp Y  &none  &none  &none  &none  &none  &none  &none  &none  &kp L  &kp K  &kp J  &kp H  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &kp M  &kp N  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK
            >;
        };

        bootloader {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bootloader  &trans  &trans  &bootloader  &trans
            >;
        };
    };
};
